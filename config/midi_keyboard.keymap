/*
 * ZMK MIDI Keyboard - Example Configuration
 * 
 * A 4x4 MIDI keyboard layout for controlling synthesizers
 * and other MIDI devices via USB.
 *
 * Setup: nice_nano_v2 or compatible nRF52840 board
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/midi.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /* 
         * Layer 0: MIDI - Chromatic scale (Octave 4-5)
         * 
         * Natural notes across two octaves:
         * Row 1: C4  D4  E4  F4
         * Row 2: G4  A4  B4  C5
         * Row 3: C5  D5  E5  F5
         * Row 4: G5  A5  B5  C6
         */
        midi_layer {
            label = "MIDI";
            bindings = <
                &midi_note C4   &midi_note D4   &midi_note E4   &midi_note F4
                &midi_note G4   &midi_note A4   &midi_note B4   &midi_note C5
                &midi_note C5   &midi_note D5   &midi_note E5   &midi_note F5
                &midi_note G5   &midi_note A5   &midi_note B5   &midi_note C6
            >;
        };

        /* 
         * Layer 1: Drum pads - Lower octaves for percussion
         * 
         * Row 1: C1  D1  E1  F1
         * Row 2: G1  A1  B1  C2
         * Row 3: C2  D2  E2  F2
         * Row 4: G2  A2  B2  C3
         */
        drum_layer {
            label = "DRUMS";
            bindings = <
                &midi_note C1   &midi_note D1   &midi_note E1   &midi_note F1
                &midi_note G1   &midi_note A1   &midi_note B1   &midi_note C2
                &midi_note C2   &midi_note D2   &midi_note E2   &midi_note F2
                &midi_note G2   &midi_note A2   &midi_note B2   &midi_note C3
            >;
        };

        /* 
         * Layer 2: Extended range with chromatic (sharps/flats)
         * 
         * Row 1: C3  C#3 D3  D#3
         * Row 2: E3  F3  F#3 G3
         * Row 3: G#3 A3  A#3 B3
         * Row 4: C4  C#4 D4  D#4
         */
        extended_layer {
            label = "CHROMATIC";
            bindings = <
                &midi_note C3   &midi_note CS3  &midi_note D3   &midi_note DS3
                &midi_note E3   &midi_note F3   &midi_note FS3  &midi_note G3
                &midi_note GS3  &midi_note A3   &midi_note AS3  &midi_note B3
                &midi_note C4   &midi_note CS4  &midi_note D4   &midi_note DS4
            >;
        };
    };
};

/*
 * MIDI Note Reference
 * ===================
 * 
 * Each MIDI note has a number from 0-127
 * C4 (Middle C) = 60
 * 
 * Note naming convention: [Note][Octave]
 * - Natural notes: C, D, E, F, G, A, B
 * - Sharps: CS (or C# in traditional notation)
 * - Flats: Use the enharmonic equivalent sharp (e.g., Db = CS)
 * 
 * Common octaves:
 * - C1 = 12 (very low)
 * - C3 = 36 (low)
 * - C4 = 60 (Middle C - reference)
 * - C5 = 72 (high)
 * - C6 = 84 (very high)
 * - C7 = 96
 * - C8 = 108
 * 
 * All natural notes in octave 4:
 * C4=60, D4=62, E4=64, F4=65, G4=67, A4=69, B4=71
 * 
 * Chromatic notes:
 * C=0, CS=1, D=2, DS=3, E=4, F=5, FS=6, G=7, GS=8, A=9, AS=10, B=11 (within octave)
 * Multiply octave by 12 and add the chromatic offset
 */

/*
 * Customization Tips
 * ==================
 * 
 * To change the keyboard layout:
 * 1. Define a new keymap layer
 * 2. Use any MIDI notes you want (C0-G8)
 * 3. Assign them to your 16 keys
 * 
 * Example custom scale (Pentatonic):
 * &midi_note C4  &midi_note D4  &midi_note E4  &midi_note G4
 * &midi_note A4  &midi_note C5  &midi_note D5  &midi_note E5
 * &midi_note G5  &midi_note A5  &midi_note C6  &midi_note D6
 * &midi_note E6  &midi_note G6  &midi_note A6  &midi_note C7
 * 
 * Example split keyboard (left/right):
 * Left hand (low):   C2, D2, E2, F2, G2, A2, B2, C3
 * Right hand (high): C5, D5, E5, F5, G5, A5, B5, C6
 */
